# デフォルトの X API 認証情報（developer.x.com のアプリ設定から取得）
# Access Token は「Read and Write」権限で発行すること
X_CONSUMER_KEY=xxxx
X_CONSUMER_SECRET=xxxx
X_ACCESS_TOKEN=xxxx
X_ACCESS_TOKEN_SECRET=xxxx

# アカウント別に別アプリの認証情報を使う場合の例
# config/accounts.yaml で credential_prefix: ANOTHER を指定したアカウント用
# ANOTHER_CONSUMER_KEY=xxxx
# ANOTHER_CONSUMER_SECRET=xxxx
# ANOTHER_ACCESS_TOKEN=xxxx
# ANOTHER_ACCESS_TOKEN_SECRET=xxxx

# reply_scout（リプライ営業支援）のリプライ下書き生成用 Claude API キー
# 未設定の場合、下書き生成はプレースホルダを返すモック動作になる（他の機能には影響しない）
ANTHROPIC_API_KEY=xxxx
